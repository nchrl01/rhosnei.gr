#X msg 415 388 set \$1;
#X obj 495 388 s space-ui;
#X obj 660 170 r av-dna;
#X floatatom 660 205 8 0 0 0 av-dna - - 0;
#X obj 660 260 r av-codon;
#X floatatom 660 295 8 0 0 0 av-codon - - 0;
#X obj 660 350 r av-phenotype;
#X floatatom 660 385 8 0 0 0 av-phenotype - - 0;
