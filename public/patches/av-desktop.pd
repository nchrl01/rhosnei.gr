#N canvas 80 80 1280 820 12;
#X text 30 20 $AV / GAMETA - native Pure Data;
#X text 30 50 Genotype -> codon -> phenotype -> strings + pads;
#X obj 30 100 market;
#X obj 180 100 av-bridge;
#X obj 30 150 tgl 24 0 run run-ui RUN 30 12 0 12 #ffffff #000000 #000000 0 1;
#X obj 30 220 hsl 210 20 0 0.8 0 0 master master-ui LISTENING_VOLUME 0 -9 0 12 #ffffff #000000 #000000 0 1;
#X obj 30 248 r master;
#X msg 115 248 set \$1;
#X obj 195 248 s master-ui;
#X obj 30 290 hsl 210 20 0 1 0 0 motion motion-ui VOLATILITY 0 -9 0 12 #ffffff #000000 #000000 0 1;
#X obj 30 318 r motion;
#X msg 115 318 set \$1;
#X obj 195 318 s motion-ui;
#X obj 30 360 hsl 210 20 0 1 0 0 texture texture-ui LIQUIDITY 0 -9 0 12 #ffffff #000000 #000000 0 1;
#X obj 30 388 r texture;
#X msg 115 388 set \$1;
#X obj 195 388 s texture-ui;
#X obj 330 220 hsl 210 20 0 1 0 0 melody melody-ui STRINGS 0 -9 0 12 #ffffff #000000 #000000 0 1;
#X obj 330 248 r melody;
#X msg 415 248 set \$1;
#X obj 495 248 s melody-ui;
#X obj 330 290 hsl 210 20 0 1 0 0 pad pad-ui PADS 0 -9 0 12 #ffffff #000000 #000000 0 1;
#X obj 330 318 r pad;
#X msg 415 318 set \$1;
#X obj 495 318 s pad-ui;
#X obj 330 360 hsl 210 20 0 1 0 0 space space-ui SPACE 0 -9 0 12 #ffffff #000000 #000000 0 1;
