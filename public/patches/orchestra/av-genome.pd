#N canvas 80 80 1280 820 12;
#X text 30 10 GAMETA / market adaptation - 8-bit genotype -> codon -> musical phenotype;
#X obj 30 60 inlet;
#X obj 30 100 f 5;
#X obj 700 60 r seed;
#X obj 700 100 expr int(abs($f1)) % 256;
#X obj 700 140 t b f;
#X msg 700 180 0;
#X obj 30 150 expr ((int($f1)*2 + int($f1/128) + 1) % 256) ^ if(($i3 % 16)==0 && $f2>0.12 \, (1 << int($f2*7)) \, 0);
#X obj 850 220 r motion;
#X obj 850 260 r generation;
#X obj 30 195 t f f;
#X obj 30 240 expr (int($f1) >> 3) & 7;
#X obj 30 280 t b f;
#X obj 30 320 f 0;
#X obj 420 195 s av-dna;
#X obj 420 240 s av-codon;
#X obj 30 370 expr if($f2==0 \, $f1 \, if($f2==1 \, min(7 \, $f1+1) \, if($f2==2 \, max(-7 \, $f1-1) \, if($f2==3 \, min(7 \, $f1+2) \, if($f2==4 \, -$f1 \, if($f2==5 \, int($f1)^1 \, if($f2==6 \, int($f1/2) \, if($f1+4>7 \, -7+($f1+4-7) \, $f1+4))))))));
#X obj 30 445 t f f;
#X obj 30 495 change -1;
#X obj 30 550 outlet;
#X obj 430 445 s av-phenotype;
#X msg 760 320 set -99;
#X text 30 600 Repeated states are suppressed here: holds and pauses belong to the algorithm.;
#X text 30 630 Market volatility perturbs one DNA bit per 16 ticks. Zero volatility preserves the original map.;
#X connect 3 0 4 0;
#X connect 4 0 5 0;
#X connect 5 1 2 1;
#X connect 8 0 7 1;
#X connect 9 0 7 2;
#X connect 1 0 2 0;
#X connect 2 0 7 0;
#X connect 7 0 10 0;
#X connect 10 1 2 1;
#X connect 10 1 14 0;
#X connect 10 0 11 0;
#X connect 11 0 12 0;
#X connect 11 0 15 0;
#X connect 12 0 13 0;
#X connect 13 0 16 0;
#X connect 16 0 17 0;
#X connect 17 0 18 0;
#X connect 18 0 19 0;
#X connect 12 1 16 1;
#X connect 17 1 13 1;
#X connect 17 1 20 0;
#X connect 5 0 6 0;
#X connect 6 0 13 1;
#X connect 5 0 21 0;
#X connect 21 0 18 0;
