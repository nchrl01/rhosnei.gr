#N canvas 50 50 1240 860 12;
#X text 25 15 Third-order Butterworth crossover / low outlet then high outlet. NOT a crossfader.;
#X obj 25 60 inlet~;
#X obj 360 60 loadbang;
#X obj 500 60 r pd-dsp-started;
#X obj 360 100 samplerate~;
#X obj 360 140 expr tan(3.14159265359*min(\$1 \, max(1 \, $f1)*0.45)/max(1 \, $f1));
#X obj 25 220 biquad~;
#X obj 25 300 biquad~;
#X obj 25 370 outlet~;
#X obj 460 210 t f f f f f;
#X obj 460 300 pack f f f f f;
#X obj 460 255 expr (1-$f1)/(1+$f1);
#X obj 615 255 expr 0;
#X obj 770 255 expr $f1/(1+$f1);
#X obj 925 255 expr $f1/(1+$f1);
#X obj 1080 255 expr 0;
#X obj 460 345 t f f f f f;
#X obj 460 435 pack f f f f f;
#X obj 460 390 expr 2*(1-$f1*$f1)/(1+$f1+$f1*$f1);
#X obj 615 390 expr -(1-$f1+$f1*$f1)/(1+$f1+$f1*$f1);
#X obj 770 390 expr $f1*$f1/(1+$f1+$f1*$f1);
#X obj 925 390 expr 2*$f1*$f1/(1+$f1+$f1*$f1);
#X obj 1080 390 expr $f1*$f1/(1+$f1+$f1*$f1);
#X obj 215 220 biquad~;
#X obj 215 300 biquad~;
#X obj 215 370 outlet~;
#X obj 460 480 t f f f f f;
#X obj 460 570 pack f f f f f;
#X obj 460 525 expr (1-$f1)/(1+$f1);
#X obj 615 525 expr 0;
#X obj 770 525 expr 1/(1+$f1);
#X obj 925 525 expr -1/(1+$f1);
#X obj 1080 525 expr 0;
#X obj 460 615 t f f f f f;
#X obj 460 705 pack f f f f f;
#X obj 460 660 expr 2*(1-$f1*$f1)/(1+$f1+$f1*$f1);
#X obj 615 660 expr -(1-$f1+$f1*$f1)/(1+$f1+$f1*$f1);
#X obj 770 660 expr 1/(1+$f1+$f1*$f1);
#X obj 925 660 expr -2*1/(1+$f1+$f1*$f1);
#X obj 1080 660 expr 1/(1+$f1+$f1*$f1);
