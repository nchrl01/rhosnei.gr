#N canvas 50 50 1240 860 12;
#X text 25 15 32-channel tonal branch. Phase modulation and envelope are inferred Gen replacements.;
#X obj 25 95 r~ \$2-ramp-\$1;
#X obj 25 135 r \$2-decay;
#X obj 25 175 pack f 50;
#X obj 25 215 line~;
#X obj 25 255 expr~ min(1 \, $v1*32)*exp(-$v1*$v2*.25)*($v1<1);
#X obj 25 295 loadbang;
#X obj 25 335 f \$1;
#X obj 25 375 expr (int($f1)*7)%12;
#X obj 25 415 tabread \$2-scale;
#X obj 25 455 r \$2-ui-tick;
#X obj 25 495 r \$2-root;
#X obj 25 535 pack f 50;
#X obj 25 575 line~;
#X obj 25 615 sig~;
#X obj 25 655 +~;
#X obj 25 695 expr 12*(int(\$1/8)-1);
#X obj 355 55 +~;
#X obj 355 95 mtof~;
#X obj 355 135 min~ 4000;
#X obj 355 175 r \$2-seed;
#X obj 355 215 expr pow(2 \, (int($f1)+\$1*17)%3);
#X obj 355 255 sig~ 1;
#X obj 355 295 *~;
#X obj 355 335 r \$2-octave;
#X obj 355 375 pack f 50;
#X obj 355 415 line~;
#X obj 355 455 /~;
#X obj 355 495 r \$2-upper;
#X obj 355 535 phasor~;
#X obj 355 575 r \$2-shape;
#X obj 355 615 pack f 50;
#X obj 355 655 line~;
#X obj 355 695 expr~ cos(6.2831853*($v1+$v2*$v3*.7));
#X obj 685 55 r \$2-density;
#X obj 685 95 pack f 50;
#X obj 685 135 line~;
#X obj 685 175 expr~ $v1>((\$1*13)%32)/32;
#X obj 685 215 *~;
#X obj 685 255 *~;
#X obj 685 295 *~ 0.045;
#X obj 685 335 outlet~;
