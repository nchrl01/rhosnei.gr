#N canvas 50 50 1240 860 12;
#X text 25 15 32 lanes: swing lookup -> staggered trigger -> one-shot ramp / independent Gen replacement.;
#X obj 25 95 r~ \$2-beats;
#X obj 25 135 loadbang;
#X obj 25 175 f \$1;
#X obj 25 215 / 32;
#X obj 25 255 +~;
#X obj 25 295 wrap~;
#X obj 25 335 expr~ (int($v1/4)%8)*32+\$1;
#X obj 25 375 tabread~ \$2-swing-table;
#X obj 25 415 r \$2-swing;
#X obj 25 455 pack f 50;
#X obj 25 495 line~;
#X obj 25 535 expr~ min(0.95 \, max(0.05 \, $v1+$v2-0.5));
#X obj 25 575 expr~ if($v1<$v2 \, 0.5*$v1/$v2 \, 0.5+0.5*($v1-$v2)/(1-$v2));
#X obj 25 615 *~ 2;
#X obj 25 655 wrap~;
#X obj 25 695 fexpr~ $x1[0] < $x1[-1];
#X obj 355 55 r \$2-duration;
#X obj 355 95 pack f 50;
#X obj 355 135 line~;
#X obj 355 175 samplerate~;
#X obj 355 215 sig~ 48000;
#X obj 355 255 r pd-dsp-started;
#X obj 355 295 expr~ 1000/max(1 \, $v1*$v2);
#X obj 355 335 fexpr~ if($x1[0]>0 && $y1[-1]>=1 \, 0 \, min(1 \, $y1[-1]+$x2[0]));
#X obj 355 375 s~ \$2-ramp-\$1;
#X obj 355 415 snapshot~;
#X obj 355 455 r \$2-ui-tick;
#X obj 355 495 tabwrite \$2-ramps;
