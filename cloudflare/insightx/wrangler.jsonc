{
  "name": "upic-insightx",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "durable_objects": { "bindings": [{ "name": "HOLDER_CACHE", "class_name": "HolderCache" }] },
