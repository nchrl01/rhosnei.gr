{
  "name": "upic-insightx",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "HOLDER_CACHE",
        "class_name": "HolderCache"
      },
      {
        "name": "TAKE_STORE",
        "class_name": "TakeStore"
      },
      {
        "name": "PROFILE_STORE",
        "class_name": "ProfileStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "HolderCache"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "TakeStore"
      ]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": [
        "ProfileStore"
      ]
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://nchrl01.github.io",
    "ADDITIONAL_ALLOWED_ORIGINS": "https://upic-art.github.io",
    "REOWN_PROJECT_ID": "c031a5adef7742a64daa372ef925894e",
    "PROFILE_APP_URL": "https://nchrl01.github.io/rhosnei.gr/"
  },
  "observability": {
    "enabled": false
  }
}
