# Copy to infra/staging/.env.renderer (gitignored) and fill in.
# Staging gateway URL + /api  (Cloudflare → Workers & Pages → pv-gate)
UPIC_API_URL=https://pv-gate.YOUR-SUBDOMAIN.workers.dev/api
# Same value as the RENDERER_TOKEN secret in the GitHub "staging" environment
RENDERER_TOKEN=
# The pv-ci Cloudflare Access service token
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# Same value as the PINATA_JWT secret
PINATA_JWT=
